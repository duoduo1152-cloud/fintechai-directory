{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "fintechai.directory" }],
      "destination": "https://www.fintechai.directory/:path*",
      "permanent": true
    }
  ]
}
